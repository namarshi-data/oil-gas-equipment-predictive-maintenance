/// Explicit measures with documented grains, denominators and filter behavior.
table KPI_Measures
	lineageTag: db77a40c-bc94-4047-8c36-bc015d6ab048

	/// Policy in context; predictive when unfiltered. An explicit multiple-policy selection returns blank to prevent adding mutually exclusive scenarios.
	measure 'Selected Policy' = IF(HASONEVALUE(Dim_Policy[policy]), SELECTEDVALUE(Dim_Policy[policy]), IF(NOT ISFILTERED(Dim_Policy), "predictive", BLANK()))
		formatString: @
		displayFolder: Context
		lineageTag: 6e2769d3-0ba1-4a8d-898f-73ebd4552bbf

	/// Visible policy scope, including the default and ambiguous multiple selections.
	measure 'Policy Selection Note' =
			VAR ChosenPolicy = [Selected Policy]
			RETURN IF(ISBLANK(ChosenPolicy), "Choose one policy for comparable totals", IF(NOT ISFILTERED(Dim_Policy), "Predictive policy (default)", SELECTEDVALUE(Dim_Policy[policy_label])))
		formatString: @
		displayFolder: Context
		lineageTag: 5faf0829-8f5c-43a5-833d-7e7c706ec019

	/// Distinct observed calendar days in the selected date/site/asset scope and evaluation window. Zero-event days count. RLS remains in force.
	measure 'Observed Days' =
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(Fact_Readings[date]),
			        KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			        KEEPFILTERS(Dim_Date[Date] <= PeriodEnd),
			        REMOVEFILTERS(Dim_Policy)
			    )
		formatString: #,0
		displayFolder: Exposure
		lineageTag: 8f5e604d-4d5c-4ece-87ba-b9bdba3f1167

	/// Selected observed days divided by 365.25; full evaluation is 91 days, not a full observed year.
	measure 'Evaluation Years' = DIVIDE([Observed Days], 365.25)
		formatString: 0.0000
		displayFolder: Exposure
		lineageTag: b58d9145-65bf-4fa4-a73c-061c0dc56000

	/// Observed asset-days divided by 365.25; exposure diagnostic, not the fleet annualization denominator.
	measure 'Asset Years' =
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			VAR AssetDays = CALCULATE(COUNTROWS(Fact_Readings), KEEPFILTERS(Dim_Date[Date] >= PeriodStart), KEEPFILTERS(Dim_Date[Date] <= PeriodEnd), REMOVEFILTERS(Dim_Policy))
			RETURN DIVIDE(AssetDays, 365.25)
		formatString: 0.00
		displayFolder: Exposure
		lineageTag: e09417a6-3c0a-4929-992e-38d8f539fcd1

	/// Uniform downtime-cost what-if value. Takes effect only in Uniform override mode.
	measure 'Downtime Cost Per Hour Value' = SELECTEDVALUE(Param_DowntimeCost[Downtime Cost Per Hour], 1000)
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Scenario
		lineageTag: 8f6b736f-b0de-4dda-af01-67c5b2f0218b

	/// Equipment defaults retain the original scenario assumptions; Uniform override applies the selected rate to every asset.
	measure 'Cost Mode' = SELECTEDVALUE(Param_CostMode[Cost Mode], "Equipment defaults")
		formatString: @
		displayFolder: Scenario
		lineageTag: 06eeb6a7-9d7d-4079-b3e0-88100e2afd7d

	/// Repair costs recognized on failure date in the selected policy/date scope.
	measure 'Emergency Repair Cost' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            SUM(Fact_Events[repair_cost_cad]),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Costs
		lineageTag: 6c471c93-26f4-40f5-b72d-da3a82dc76d8

	/// Planned service costs recognized on service date. Carry-in visits stay in the audit ledger but are not charged again.
	measure 'Planned Service Cost' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            SUM(Fact_ServiceVisits[planned_cost_cad]),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_ServiceVisits[in_evaluation_window] = TRUE()),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Costs
		lineageTag: 822a44ed-9f9b-44e0-b7da-3098b0850d5c

	/// Atomic downtime hours multiplied by the related equipment rate, or the live uniform-rate scenario. Date, site, asset and RLS filters are retained.
	measure 'Unplanned Downtime Cost' =
			VAR UseUniformRate = [Cost Mode] = "Uniform override"
			VAR UniformRate = [Downtime Cost Per Hour Value]
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            SUMX(Fact_Events, Fact_Events[downtime_hours] * IF(UseUniformRate, UniformRate, RELATED(Dim_Asset[default_downtime_cost_per_hour]))),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Costs
		lineageTag: b19bbc9e-b7f9-4753-86c7-e6dfa48a23b9

	/// Atomic downtime hours multiplied by the related equipment rate, or the live uniform-rate scenario. Date, site, asset and RLS filters are retained.
	measure 'Planned Downtime Cost' =
			VAR UseUniformRate = [Cost Mode] = "Uniform override"
			VAR UniformRate = [Downtime Cost Per Hour Value]
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            SUMX(Fact_ServiceVisits, Fact_ServiceVisits[planned_downtime_hours] * IF(UseUniformRate, UniformRate, RELATED(Dim_Asset[default_downtime_cost_per_hour]))),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_ServiceVisits[in_evaluation_window] = TRUE()),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Costs
		lineageTag: e740a0e3-439a-4622-ba34-bd88a2e9b714

	/// Emergency repair plus planned service plus all incurred downtime cost. A day with observations and no costs returns zero.
	measure 'Total Cost' =
			VAR ChosenPolicy = [Selected Policy]
			VAR IncurredCost = COALESCE([Emergency Repair Cost], 0) + COALESCE([Planned Service Cost], 0) + COALESCE([Unplanned Downtime Cost], 0) + COALESCE([Planned Downtime Cost], 0)
			RETURN IF(NOT ISBLANK(ChosenPolicy) && [Observed Days] > 0, IncurredCost)
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Costs
		lineageTag: 5ecd575d-63ad-4b62-8d04-3a73a27866ee

	/// Fleet cost annualized over selected observed days. This is a synthetic extrapolation, not realized savings or an observed full year.
	measure 'Annualized Cost' =
			VAR IncurredCost = [Total Cost]
			VAR ExposureYears = [Evaluation Years]
			RETURN DIVIDE(IncurredCost, ExposureYears)
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Costs
		lineageTag: fdec5cd7-adf8-4e56-8a0c-4314ab780e4e

	/// Annualized reactive cost minus the current policy cost. The baseline re-evaluates the measure inside CALCULATE and removes only policy filters; site/date/asset/RLS and cost parameters remain.
	measure 'Cost Avoided vs Reactive' =
			VAR SelectedCost = [Annualized Cost]
			VAR ReactiveCost = CALCULATE([Annualized Cost], REMOVEFILTERS(Dim_Policy), Dim_Policy[policy] = "reactive")
			RETURN IF(NOT ISBLANK(SelectedCost), ReactiveCost - SelectedCost)
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Comparisons
		lineageTag: 8cb807a5-ad4b-4b50-b195-a51691d9e14e

	/// Explicit policy comparison with the same date, site, asset, security and cost scenario scope.
	measure 'Reactive Annualized Cost' = CALCULATE([Annualized Cost], REMOVEFILTERS(Dim_Policy), Dim_Policy[policy] = "reactive")
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Comparisons
		lineageTag: eea62c6b-9422-41d4-b570-b6476875020c

	/// Explicit policy comparison with the same date, site, asset, security and cost scenario scope.
	measure 'Fixed Annualized Cost' = CALCULATE([Annualized Cost], REMOVEFILTERS(Dim_Policy), Dim_Policy[policy] = "fixed_90_day")
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Comparisons
		lineageTag: 1f5c15e8-844a-4ea8-b9ed-d9765c79dda8

	/// Explicit policy comparison with the same date, site, asset, security and cost scenario scope.
	measure 'Predictive Annualized Cost' = CALCULATE([Annualized Cost], REMOVEFILTERS(Dim_Policy), Dim_Policy[policy] = "predictive")
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Comparisons
		lineageTag: e8af047a-babf-4fa3-8bb6-d878300f9d6a

	/// Predictive annualized net cost advantage over the fixed 90-day maintenance scenario.
	measure 'Cost Avoided vs Fixed' = [Fixed Annualized Cost] - [Predictive Annualized Cost]
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Comparisons
		lineageTag: b77d0940-d527-4faa-b148-d1beca0e87e7

	/// Three additive waterfall bars reach predictive annual cost. Predictive total is reserved for a total marker, never added as another change.
	measure 'Waterfall Cost' =
			VAR Stage = SELECTEDVALUE(Dim_CostStep[Step])
			RETURN SWITCH(Stage,
			    "Reactive baseline", [Reactive Annualized Cost],
			    "Fixed schedule change", [Fixed Annualized Cost] - [Reactive Annualized Cost],
			    "Predictive change", [Predictive Annualized Cost] - [Fixed Annualized Cost],
			    "Predictive total", [Predictive Annualized Cost],
			    BLANK())
		formatString: "C$"#,0;("C$"#,0);"C$"0
		displayFolder: Comparisons
		lineageTag: 7f1b6266-8706-48df-ad2b-9a1c6301ce0d

	/// Events for one maintenance policy. Scenarios replay the same physical failures and must not be added across policies.
	measure 'Event Count' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            COALESCE(COUNTROWS(Fact_Events), 0),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: #,0
		displayFolder: Events
		lineageTag: c1e74a4b-772f-4bd5-abf4-d26c9ee24790

	/// Failure events prevented by a successful intervention in the chosen policy.
	measure 'Caught Events' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            COALESCE(COUNTROWS(Fact_Events), 0),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_Events[caught] = TRUE()),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: #,0
		displayFolder: Events
		lineageTag: f1b65b4d-5062-447e-b3ab-6353308eff80

	/// Failures not prevented in the chosen maintenance policy, including unsuccessful interventions.
	measure 'Missed Events' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            COALESCE(COUNTROWS(Fact_Events), 0),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_Events[caught] = FALSE()),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: #,0
		displayFolder: Events
		lineageTag: c3512bcb-f574-4768-bceb-bb06a28c8b37

	/// Breakdown means caught=false events. Uses predictive policy when policy is unfiltered; select one other policy to compare. Never a synonym for the caught Boolean column.
	measure Breakdowns = [Missed Events]
		formatString: #,0
		displayFolder: Events
		lineageTag: f1d4caa1-8533-42fc-bc76-b56f7b4b116b

	/// Successfully prevented failure events divided by all events for the selected policy; event-level, not classifier recall.
	measure 'Catch Rate' =
			VAR Caught = [Caught Events]
			VAR EligibleEvents = [Event Count]
			RETURN DIVIDE(COALESCE(Caught, 0), EligibleEvents)
		formatString: 0.0%
		displayFolder: Events
		lineageTag: b490383c-2b72-4623-9bb0-9990579c61d2

	/// Mean alert-to-failure lead time among caught events only. Blank for reactive maintenance because no events were caught.
	measure 'Mean Warning Days' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            AVERAGE(Fact_Events[warning_days]),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_Events[caught] = TRUE()),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: 0.0
		displayFolder: Events
		lineageTag: a7fd9df2-f56f-4f89-8668-ce61799de678

	/// Median warning among successfully caught events; excludes missed-event zeroes.
	measure 'Median Warning Days' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            MEDIAN(Fact_Events[warning_days]),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_Events[caught] = TRUE()),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: 0.0
		displayFolder: Events
		lineageTag: 3afa82d1-bbe3-4067-832f-0b7842388139

	/// Charged visits whose service date lies within the evaluation window and current date selection.
	measure 'Service Visits' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            COALESCE(COUNTROWS(Fact_ServiceVisits), 0),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_ServiceVisits[in_evaluation_window] = TRUE()),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: #,0
		displayFolder: Service
		lineageTag: b830af81-e865-48a4-be9d-7063092ea1a5

	/// All recorded visits, including carry-in visits when their service dates are selected. Does not expand the date selection automatically.
	measure 'Ledger Service Visits' =
			VAR ChosenPolicy = [Selected Policy]
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            COALESCE(COUNTROWS(Fact_ServiceVisits), 0),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy)
			        )
			    )
		formatString: #,0
		displayFolder: Service
		lineageTag: 305cd1c7-b1f0-41bb-886b-8c2dd235bdb2

	/// Audit-only visits preceding evaluation; excluded from incurred cost and operational false-alarm denominators.
	measure 'Carry In Visits' =
			VAR ChosenPolicy = [Selected Policy]
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            COALESCE(COUNTROWS(Fact_ServiceVisits), 0),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_ServiceVisits[in_evaluation_window] = FALSE())
			        )
			    )
		formatString: #,0
		displayFolder: Service
		lineageTag: fe866559-f0b0-4310-b851-743de53fc274

	/// Charged visits with this outcome; carry-in visits are excluded.
	measure 'Unnecessary Services' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            COALESCE(COUNTROWS(Fact_ServiceVisits), 0),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_ServiceVisits[in_evaluation_window] = TRUE()),
			            KEEPFILTERS(Fact_ServiceVisits[outcome] = "no_actionable_failure"),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: #,0
		displayFolder: Service
		lineageTag: fd770b65-eca2-4713-9335-23442379c420

	/// Charged visits with this outcome; carry-in visits are excluded.
	measure 'Unsuccessful Services' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            COALESCE(COUNTROWS(Fact_ServiceVisits), 0),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_ServiceVisits[in_evaluation_window] = TRUE()),
			            KEEPFILTERS(Fact_ServiceVisits[outcome] = "intervention_unsuccessful"),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: #,0
		displayFolder: Service
		lineageTag: ff7bea9d-0ebd-40e3-b968-3013437039fa

	/// Charged visits with this outcome; carry-in visits are excluded.
	measure 'Successful Services' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            COALESCE(COUNTROWS(Fact_ServiceVisits), 0),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_ServiceVisits[in_evaluation_window] = TRUE()),
			            KEEPFILTERS(Fact_ServiceVisits[outcome] = "prevented_failure"),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: #,0
		displayFolder: Service
		lineageTag: baf56a63-4311-4b80-8d96-037d492e1726

	/// Operational false-alarm rate = no_actionable_failure visits / charged visits. This is not classifier FP/(FP+TN).
	measure 'False Alarm Rate' =
			VAR FalseAlarms = [Unnecessary Services]
			VAR ChargedVisits = [Service Visits]
			RETURN DIVIDE(COALESCE(FalseAlarms, 0), ChargedVisits)
		formatString: 0.0%
		displayFolder: Service
		lineageTag: ac01fe44-5cd0-4f52-8e67-9d90042f262e

	/// Share of charged service visits with no actionable failure.
	measure 'Unnecessary Service Rate' = [False Alarm Rate]
		formatString: 0.0%
		displayFolder: Service
		lineageTag: 262b0009-671b-4a90-9f36-75ac408cbbbd

	/// Share of charged visits where intervention did not prevent the actionable failure.
	measure 'Unsuccessful Service Rate' = DIVIDE(COALESCE([Unsuccessful Services], 0), [Service Visits])
		formatString: 0.0%
		displayFolder: Service
		lineageTag: ca4cf1ab-98b6-4c74-a772-39d2a2df26de

	/// Unplanned downtime recognized on event date in the selected policy.
	measure 'Unplanned Downtime Hours' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            SUM(Fact_Events[downtime_hours]),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: #,0.0
		displayFolder: Costs
		lineageTag: 392e899a-54f7-4f66-bc88-e7a45ff8f74b

	/// Planned downtime of charged service visits.
	measure 'Planned Downtime Hours' =
			VAR ChosenPolicy = [Selected Policy]
			VAR PeriodStart = MIN(Config_Model[evaluation_start])
			VAR PeriodEnd = MAX(Config_Model[evaluation_end])
			RETURN
			    IF(NOT ISBLANK(ChosenPolicy),
			        CALCULATE(
			            SUM(Fact_ServiceVisits[planned_downtime_hours]),
			            KEEPFILTERS(Dim_Policy[policy] = ChosenPolicy),
			            KEEPFILTERS(Fact_ServiceVisits[in_evaluation_window] = TRUE()),
			            KEEPFILTERS(Dim_Date[Date] >= PeriodStart),
			            KEEPFILTERS(Dim_Date[Date] <= PeriodEnd)
			        )
			    )
		formatString: #,0.0
		displayFolder: Costs
		lineageTag: 2a59a45e-05e9-4354-bca1-8cfe7d7c5b91

	/// Relative reduction in unplanned downtime for the predictive versus fixed-interval policy within identical filters.
	measure 'Downtime Reduction vs Fixed' =
			VAR FixedHours = CALCULATE([Unplanned Downtime Hours], REMOVEFILTERS(Dim_Policy), Dim_Policy[policy] = "fixed_90_day")
			VAR PredictiveHours = CALCULATE([Unplanned Downtime Hours], REMOVEFILTERS(Dim_Policy), Dim_Policy[policy] = "predictive")
			RETURN DIVIDE(FixedHours - PredictiveHours, FixedHours)
		formatString: 0.0%
		displayFolder: Comparisons
		lineageTag: eb496c36-d558-4372-8303-de2922547135

	/// Assets with observations in the selected date/site/asset scope, respecting RLS. Zero when there are no visible observations.
	measure 'Asset Count' = COALESCE(DISTINCTCOUNT(Fact_Readings[asset_id]), 0)
		formatString: #,0
		displayFolder: Condition
		lineageTag: c2fcd2c7-4b8a-4071-a26f-00412701355f

	/// Daily asset observations; shared by all maintenance policies and never duplicated by policy. Zero for an empty visible set.
	measure 'Reading Count' = COALESCE(COUNTROWS(Fact_Readings), 0)
		formatString: #,0
		displayFolder: Condition
		lineageTag: 49185816-4e8e-4d07-a9dd-37d7a93154af

	/// Mean model risk score across selected daily observations. Scores are not separately calibrated probabilities.
	measure 'Mean Risk Score' = AVERAGE(Fact_Readings[risk_score])
		formatString: 0.0%
		displayFolder: Condition
		lineageTag: e7274b57-aeed-4fa0-bba8-6ed651b55db0

	/// Each asset's latest observed risk within selected dates; aggregate cells average these latest asset risks. Never sums risk or reads a precomputed asset-summary score.
	measure 'Latest Risk Score' =
			AVERAGEX(
			    VALUES(Dim_Asset[asset_id]),
			    VAR LatestObservedDate = CALCULATE(MAX(Fact_Readings[date]))
			    RETURN IF(NOT ISBLANK(LatestObservedDate), CALCULATE(AVERAGE(Fact_Readings[risk_score]), KEEPFILTERS(Dim_Date[Date] = LatestObservedDate)))
			)
		formatString: 0.0%
		displayFolder: Condition
		lineageTag: a6114be4-89f4-499c-bb73-6e6336f9f08a

	/// Compatibility alias for Latest Risk Score.
	measure latest_risk_score = [Latest Risk Score]
		formatString: 0.0%
		displayFolder: Condition
		lineageTag: 4f92cea2-3740-4ae5-a37a-d1afec3bb15f

	/// Latest telemetry snapshot within the current asset/site/date/security scope.
	measure 'Latest Observation Date' = MAX(Fact_Readings[date])
		formatString: yyyy-mm-dd
		displayFolder: Condition
		lineageTag: 53fdff69-0727-41bc-99e4-fca325065b2c

	/// Decision threshold selected on validation data; fixed for the test period.
	measure 'Alert Threshold' = MAX(Config_Model[alert_threshold])
		formatString: 0.000
		displayFolder: Condition
		lineageTag: c88ffb2b-7925-4858-a1b0-f6a9adc1e9a9

	/// Trailing seven calendar days ending at the current visible latest observation. The date filter is replaced by that window; asset/site/RLS remain. Missing scores are excluded from the average.
	measure 'Risk Score 7D Avg' =
			VAR LastObservedDate = MAX(Fact_Readings[date])
			VAR WindowStart = LastObservedDate - 6
			RETURN IF(NOT ISBLANK(LastObservedDate),
			    CALCULATE(
			        [Mean Risk Score],
			        REMOVEFILTERS(Dim_Date),
			        DATESBETWEEN(Dim_Date[Date], WindowStart, LastObservedDate)
			    )
			)
		formatString: 0.0%
		displayFolder: Condition
		lineageTag: 0e86b71a-b61d-4567-a4ef-0180cab924d8

	/// Mean sensor reading in the selected daily observations; units follow the source column.
	measure 'Mean Vibration' = AVERAGE(Fact_Readings[vibration_mm_s])
		formatString: 0.00
		displayFolder: Sensors
		lineageTag: 34132545-7d98-499a-9a3d-5a762126f496

	/// Mean sensor reading in the selected daily observations; units follow the source column.
	measure 'Mean Temperature' = AVERAGE(Fact_Readings[bearing_temperature_c])
		formatString: 0.0
		displayFolder: Sensors
		lineageTag: 7d563373-0dce-4ed2-a928-58561e0ffa74

	/// Mean sensor reading in the selected daily observations; units follow the source column.
	measure 'Mean Pressure' = AVERAGE(Fact_Readings[pressure_bar])
		formatString: 0.00
		displayFolder: Sensors
		lineageTag: bb7ba595-7491-43a8-8eb1-1eb10de6005b

	/// Mean sensor reading in the selected daily observations; units follow the source column.
	measure 'Mean RPM' = AVERAGE(Fact_Readings[rpm])
		formatString: #,0.0
		displayFolder: Sensors
		lineageTag: c772dc1f-981f-4cc7-b970-561faffdc9d5

	/// Mean sensor reading in the selected daily observations; units follow the source column.
	measure 'Mean Runtime Hours' = AVERAGE(Fact_Readings[runtime_hours])
		formatString: #,0.0
		displayFolder: Sensors
		lineageTag: 5e605c3f-7b9c-4050-af64-392d75647256

	/// Mean sensor reading in the selected daily observations; units follow the source column.
	measure 'Mean Load' = AVERAGE(Fact_Readings[load_pct])
		formatString: 0.0
		displayFolder: Sensors
		lineageTag: e12e124a-cdb6-4206-a964-c67aff07d702

	/// Mean sensor reading in the selected daily observations; units follow the source column.
	measure 'Mean Power' = AVERAGE(Fact_Readings[power_kw])
		formatString: 0.0
		displayFolder: Sensors
		lineageTag: dec87942-58c1-4534-ab2a-b447ac3fbd22

	/// Share of asset-days with at least one originally missing sensor; dashboard readings contain the pipeline's imputed values.
	measure 'Sensor Gap Rate' = DIVIDE(CALCULATE(COUNTROWS(Fact_Readings), KEEPFILTERS(Fact_Readings[sensor_missing_count] > 0)), [Reading Count])
		formatString: 0.0%
		displayFolder: Condition
		lineageTag: 6adf0970-9da6-42ff-9c18-262b229b75f5

	/// Observations with a fully observed 30-day outcome and nonblank prediction; right-censored target rows are excluded. Empty sets count as zero.
	measure 'Labeled Readings' = COALESCE(COUNTROWS(FILTER(Fact_Readings, NOT ISBLANK(Fact_Readings[target_failure_30d]) && NOT ISBLANK(Fact_Readings[alert]))), 0)
		formatString: #,0
		displayFolder: Classification
		lineageTag: 1398515a-3e1c-43da-9c04-d38ce3be22a0

	/// Right-censored or unlabeled observations excluded from classifier performance, retained for risk operations.
	measure 'Unlabeled Readings' = [Reading Count] - [Labeled Readings]
		formatString: #,0
		displayFolder: Classification
		lineageTag: 99b69c57-3d64-45f6-83c5-4eb1474e6ecb

	/// Asset-day classification count after excluding blank targets/predictions. Empty cells count as zero. Distinct from event-level catch rate.
	measure 'Prediction TP' = COALESCE(COUNTROWS(FILTER(Fact_Readings, NOT ISBLANK(Fact_Readings[target_failure_30d]) && NOT ISBLANK(Fact_Readings[alert]) && Fact_Readings[target_failure_30d] == TRUE() && Fact_Readings[alert] == TRUE())), 0)
		formatString: #,0
		displayFolder: Classification
		lineageTag: 369e40f3-fe34-4a92-950e-bbeb3f5eba90

	/// Asset-day classification count after excluding blank targets/predictions. Empty cells count as zero. Distinct from event-level catch rate.
	measure 'Prediction FP' = COALESCE(COUNTROWS(FILTER(Fact_Readings, NOT ISBLANK(Fact_Readings[target_failure_30d]) && NOT ISBLANK(Fact_Readings[alert]) && Fact_Readings[target_failure_30d] == FALSE() && Fact_Readings[alert] == TRUE())), 0)
		formatString: #,0
		displayFolder: Classification
		lineageTag: 7639e123-7f4e-4173-9776-57d1c359aaae

	/// Asset-day classification count after excluding blank targets/predictions. Empty cells count as zero. Distinct from event-level catch rate.
	measure 'Prediction FN' = COALESCE(COUNTROWS(FILTER(Fact_Readings, NOT ISBLANK(Fact_Readings[target_failure_30d]) && NOT ISBLANK(Fact_Readings[alert]) && Fact_Readings[target_failure_30d] == TRUE() && Fact_Readings[alert] == FALSE())), 0)
		formatString: #,0
		displayFolder: Classification
		lineageTag: 69ad277a-7b1a-4b66-87e4-172cbe05f537

	/// Asset-day classification count after excluding blank targets/predictions. Empty cells count as zero. Distinct from event-level catch rate.
	measure 'Prediction TN' = COALESCE(COUNTROWS(FILTER(Fact_Readings, NOT ISBLANK(Fact_Readings[target_failure_30d]) && NOT ISBLANK(Fact_Readings[alert]) && Fact_Readings[target_failure_30d] == FALSE() && Fact_Readings[alert] == FALSE())), 0)
		formatString: #,0
		displayFolder: Classification
		lineageTag: f7841d3c-254d-4e8b-be28-bc423ff9c28f

	/// One confusion-matrix cell from disconnected actual/predicted label axes. Totals intentionally blank.
	measure 'Confusion Count' =
			VAR Actual = SELECTEDVALUE(Dim_ConfusionActual[Actual])
			VAR Predicted = SELECTEDVALUE(Dim_ConfusionPredicted[Predicted])
			RETURN SWITCH(TRUE(),
			    Actual = "Failure" && Predicted = "Failure", [Prediction TP],
			    Actual = "No failure" && Predicted = "Failure", [Prediction FP],
			    Actual = "Failure" && Predicted = "No failure", [Prediction FN],
			    Actual = "No failure" && Predicted = "No failure", [Prediction TN],
			    BLANK())
		formatString: #,0
		displayFolder: Classification
		lineageTag: 11abf15a-6c9e-47f7-ab72-12f08fccd879

	/// Asset-day positive predictive value among labeled rows.
	measure Precision = DIVIDE([Prediction TP], [Prediction TP] + [Prediction FP])
		formatString: 0.0%
		displayFolder: Classification
		lineageTag: 84e5b7cc-d31e-4f8b-a8d2-2064d263d5dc

	/// Asset-day sensitivity among labeled rows; not the policy event catch rate.
	measure Recall = DIVIDE([Prediction TP], [Prediction TP] + [Prediction FN])
		formatString: 0.0%
		displayFolder: Classification
		lineageTag: b9259858-e639-46ce-9091-d9803c5cef13

	/// FP/(FP+TN) on labeled asset-days, distinct from unnecessary service/charged visits.
	measure 'Classifier False Positive Rate' = DIVIDE([Prediction FP], [Prediction FP] + [Prediction TN])
		formatString: 0.0%
		displayFolder: Classification
		lineageTag: a8476963-7a6c-4a98-a8de-e5a746bd9af9

	/// Diagnostic UPN for security testing. Use the actual sign-in UPN, not an assumed email alias.
	measure 'Current User' = USERPRINCIPALNAME()
		formatString: @
		displayFolder: Security
		lineageTag: 982c597d-aca6-4a26-b5f5-e682a6b18864

	/// Latest model score versus the validation-selected threshold; a decision aid for the reliability engineer.
	measure 'Risk Status' =
			VAR Risk = [Latest Risk Score]
			RETURN IF(ISBLANK(Risk), "No observation", IF(Risk >= [Alert Threshold], "Inspect / dispatch", IF(Risk >= [Alert Threshold] / 2, "Watch trend", "Routine monitoring")))
		formatString: @
		displayFolder: Condition
		lineageTag: 2e0ec0bb-1b92-4a9b-a8ea-3f487c222a3b

	/// Accessible severity palette for current asset risk. Always pair colour with Risk Status text.
	measure 'Risk Color' =
			VAR Risk = [Latest Risk Score]
			RETURN SWITCH(TRUE(), ISBLANK(Risk), "#64748B", Risk >= [Alert Threshold], "#B54747", Risk >= [Alert Threshold] / 2, "#B7791F", "#087F8C")
		formatString: @
		displayFolder: Condition
		lineageTag: 2151743a-085b-4354-b644-733938e8867d

	/// Report binding alias for Mean Risk Score; same filter and denominator semantics.
	measure 'Mean Risk' = [Mean Risk Score]
		formatString: 0.0%
		displayFolder: Report aliases
		lineageTag: 51d2796d-a750-44c4-85f2-2f889451d12a

	/// Report binding alias for Labeled Readings; same filter and denominator semantics.
	measure 'Labeled Reading Count' = [Labeled Readings]
		formatString: #,0
		displayFolder: Report aliases
		lineageTag: 81de64cc-913b-40a0-abb6-abed36b06704

	/// Report binding alias for Latest Observation Date; same filter and denominator semantics.
	measure 'Latest Reading Date' = [Latest Observation Date]
		formatString: yyyy-mm-dd
		displayFolder: Report aliases
		lineageTag: 7dc1cb0c-5885-4324-a604-6569aa101f04

	/// Report binding alias for Risk Status; same filter and denominator semantics.
	measure 'Latest Risk Status' = [Risk Status]
		formatString: @
		displayFolder: Report aliases
		lineageTag: 49ac9573-df36-40be-beec-cce99a353837

	/// Report binding alias for Risk Color; same filter and denominator semantics.
	measure 'Latest Risk Color' = [Risk Color]
		formatString: @
		displayFolder: Report aliases
		lineageTag: 37b2f326-c9f4-4c2e-b11b-c15b1504cdc5

	/// Report binding alias for Breakdowns; same filter and denominator semantics.
	measure 'Breakdown Events' = [Breakdowns]
		formatString: #,0
		displayFolder: Report aliases
		lineageTag: 17e223f5-fe83-4f93-9cac-a19401baf138

	/// Dynamic comparison statement that displays selected observed exposure and labels the scenario as synthetic.
	measure 'Executive Insight' =
			VAR Savings = [Cost Avoided vs Fixed]
			VAR Days = [Observed Days]
			VAR Assets = [Asset Count]
			RETURN IF(Days > 0,
			    "Predictive maintenance " & IF(Savings >= 0, "avoids ", "adds ") & "C$" & FORMAT(ABS(Savings), "#,##0", "en-CA") & "/year versus fixed service | " & FORMAT(Assets, "0") & " assets, " & FORMAT(Days, "0") & " observed days | Synthetic scenario",
			    "No observed exposure in the selected site, asset and date scope")
		formatString: @
		displayFolder: Context
		lineageTag: f613ead7-65c2-44b1-9bce-336e41bdea5e

	/// Unique latest-risk rank within selected site, asset and date context; descending score with asset ID as deterministic tie-break. Blank risks are excluded and RLS remains in force. Used only to bound the six-row Fleet queue.
	measure 'Fleet Queue Rank' =
			VAR CurrentAsset = SELECTEDVALUE(Dim_Asset[asset_id])
			VAR CurrentRisk = [Latest Risk Score]
			VAR Candidates =
			    FILTER(
			        ADDCOLUMNS(ALLSELECTED(Dim_Asset[asset_id]), "__QueueRisk", [Latest Risk Score]),
			        NOT ISBLANK([__QueueRisk])
			    )
			RETURN
			    IF(
			        NOT ISBLANK(CurrentAsset) && NOT ISBLANK(CurrentRisk),
			        1 + COUNTROWS(
			            FILTER(
			                Candidates,
			                [__QueueRisk] > CurrentRisk
			                    || ([__QueueRisk] = CurrentRisk && Dim_Asset[asset_id] < CurrentAsset)
			            )
			        )
			    )
		formatString: 0
		displayFolder: Condition

	/// anchor.
	column _anchor
		dataType: int64
		isHidden
		lineageTag: 915f7f56-43bd-47fa-910e-81e8acbc63fb
		summarizeBy: none
		sourceColumn: _anchor

	partition KPI_Measures = m
		mode: import
		source = let Source = #table(type table [_anchor=Int64.Type], {{0}}) in Source

