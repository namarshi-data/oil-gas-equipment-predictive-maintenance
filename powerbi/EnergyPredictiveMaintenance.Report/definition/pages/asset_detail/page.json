{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/page/2.1.0/schema.json",
  "name": "asset_detail",
  "displayName": "Asset Detail",
  "displayOption": "FitToPage",
  "width": 1280,
  "height": 720,
  "objects": {
    "background": [
      {
        "properties": {
          "color": {
            "solid": {
              "color": {
                "expr": {
                  "Literal": {
                    "Value": "'#F4F6F8'"
                  }
                }
              }
            }
          },
          "transparency": {
            "expr": {
              "Literal": {
                "Value": "0D"
              }
            }
          }
        }
      }
    ]
  },
  "visibility": "HiddenInViewMode",
  "type": "Drillthrough",
  "pageBinding": {
    "name": "binding_asset_detail",
    "type": "Drillthrough",
    "acceptsFilterContext": "Default",
    "parameters": [
      {
        "name": "asset_detail_asset",
        "boundFilter": "asset_drillthrough",
        "fieldExpr": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Asset"
              }
            },
            "Property": "asset_id"
          }
        }
      }
    ]
  },
  "filterConfig": {
    "filters": [
      {
        "name": "asset_drillthrough",
        "field": {
          "Column": {
            "Expression": {
              "SourceRef": {
                "Entity": "Dim_Asset"
              }
            },
            "Property": "asset_id"
          }
        },
        "type": "Categorical",
        "howCreated": "Drillthrough"
      }
    ]
  }
}
